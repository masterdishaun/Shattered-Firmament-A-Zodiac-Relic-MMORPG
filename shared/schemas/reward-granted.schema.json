{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shattered-firmament.invalid/schemas/reward-granted.schema.json",
  "title": "Reward Granted Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocolVersion", "payload"],
  "properties": {
    "type": { "const": "S2C_RewardGranted" },
    "protocolVersion": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "experienceAwarded",
        "totalExperience",
        "level",
        "silverAwarded",
        "totalSilver",
        "loot"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "enum": ["rift-stalker", "ashen-wisp", "jadebound-sentinel"]
        },
        "experienceAwarded": { "type": "integer", "minimum": 0 },
        "totalExperience": { "type": "integer", "minimum": 0 },
        "level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "silverAwarded": { "type": "integer", "minimum": 0 },
        "totalSilver": { "type": "integer", "minimum": 0 },
        "loot": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["itemId", "quantity", "tradeable"],
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "quantity": { "type": "integer", "minimum": 1 },
              "tradeable": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
