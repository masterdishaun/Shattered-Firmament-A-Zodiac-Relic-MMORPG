{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shattered-firmament.invalid/schemas/world-snapshot.schema.json",
  "title": "World Snapshot Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocolVersion", "payload"],
  "properties": {
    "type": {
      "const": "S2C_WorldSnapshot"
    },
    "protocolVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverTick", "serverTime", "players"],
      "properties": {
        "serverTick": {
          "type": "integer",
          "minimum": 0
        },
        "serverTime": {
          "type": "string",
          "minLength": 20
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "characterId",
              "name",
              "mapId",
              "position",
              "movementSequence",
              "health",
              "maxHealth"
            ],
            "properties": {
              "characterId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "mapId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "facing"],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -32,
                    "maximum": 32
                  },
                  "y": {
                    "type": "number",
                    "minimum": -12,
                    "maximum": 12
                  },
                  "facing": {
                    "type": "number",
                    "minimum": -6.284,
                    "maximum": 6.284
                  }
                }
              },
              "movementSequence": {
                "type": "integer",
                "minimum": 0
              },
              "health": {
                "type": "integer",
                "minimum": 0
              },
              "maxHealth": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
