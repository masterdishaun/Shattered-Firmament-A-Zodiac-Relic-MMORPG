{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shattered-firmament.dev/schemas/world-snapshot.schema.json",
  "title": "World Snapshot Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocolVersion", "payload"],
  "properties": {
    "type": { "const": "S2C_WorldSnapshot" },
    "protocolVersion": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverTick", "serverTime", "players", "enemies"],
      "properties": {
        "serverTick": { "type": "integer", "minimum": 0 },
        "serverTime": { "type": "string", "minLength": 20 },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "characterId",
              "name",
              "classId",
              "mapId",
              "position",
              "movementSequence",
              "health",
              "maxHealth",
              "mana",
              "maxMana"
            ],
            "properties": {
              "characterId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "name": { "type": "string", "minLength": 1, "maxLength": 24 },
              "classId": {
                "type": "string",
                "enum": ["vanguard", "mystic", "support"]
              },
              "mapId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "facing"],
                "properties": {
                  "x": { "type": "number", "minimum": -32, "maximum": 32 },
                  "y": { "type": "number", "minimum": -32, "maximum": 32 },
                  "facing": {
                    "type": "number",
                    "minimum": -6.284,
                    "maximum": 6.284
                  }
                }
              },
              "movementSequence": { "type": "integer", "minimum": 0 },
              "health": { "type": "integer", "minimum": 0 },
              "maxHealth": { "type": "integer", "minimum": 1 },
              "mana": { "type": "integer", "minimum": 0 },
              "maxMana": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "enemies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "mapId",
              "position",
              "health",
              "maxHealth",
              "archetype",
              "attackStyle",
              "aiState",
              "telegraphEndsAtMs",
              "targetCharacterId"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "mapId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "number", "minimum": -32, "maximum": 32 },
                  "y": { "type": "number", "minimum": -32, "maximum": 32 }
                }
              },
              "health": { "type": "integer", "minimum": 0 },
              "maxHealth": { "type": "integer", "minimum": 1 },
              "archetype": {
                "type": "string",
                "enum": ["ashen-wisp", "jadebound-sentinel", "rift-stalker"]
              },
              "attackStyle": {
                "type": "string",
                "enum": ["ranged", "heavy-melee", "quick-melee"]
              },
              "aiState": {
                "type": "string",
                "enum": ["idle", "approach", "telegraph", "recover", "dead"]
              },
              "telegraphEndsAtMs": { "type": "integer", "minimum": 0 },
              "targetCharacterId": { "type": "string", "maxLength": 80 }
            }
          }
        }
      }
    }
  }
}
