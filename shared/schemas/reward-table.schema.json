{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shattered-firmament.invalid/schemas/reward-table.schema.json",
  "title": "Reward Table Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "rollPolicy", "entries"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "rollPolicy": {
      "enum": [
        "guaranteed",
        "personal_roll",
        "contribution_weighted",
        "bad_luck_protected"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rewardType",
          "quantityMin",
          "quantityMax",
          "chance",
          "tradeable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "rewardType": {
            "enum": ["item", "currency", "experience", "cosmetic", "material"]
          },
          "itemId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "currencyCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,15}$"
          },
          "quantityMin": { "type": "integer", "minimum": 1 },
          "quantityMax": { "type": "integer", "minimum": 1 },
          "chance": { "type": "number", "minimum": 0, "maximum": 1 },
          "tradeable": { "type": "boolean" },
          "badLuckGroupId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
