{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shattered-firmament.invalid/schemas/dungeon-definition.schema.json",
  "title": "Dungeon Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "mode",
    "levelMin",
    "levelMax",
    "partySizeMin",
    "partySizeMax",
    "zoneId",
    "encounterIds",
    "rewardTableId",
    "factionAccess"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "mode": {
      "enum": [
        "solo_story",
        "party_normal",
        "party_hard",
        "party_challenge",
        "raid"
      ]
    },
    "levelMin": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "levelMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "partySizeMin": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "partySizeMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "zoneId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "encounterIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      }
    },
    "rewardTableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "factionAccess": {
      "enum": ["all", "own_faction", "faction_instance"]
    },
    "factionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["sovereign_sect", "ashen_syndicate", "astral_concord"]
      }
    },
    "essentialProgression": {
      "type": "boolean",
      "default": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "solo_story"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "partySizeMin": {
            "const": 1
          },
          "partySizeMax": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "factionAccess": {
            "enum": ["own_faction", "faction_instance"]
          }
        },
        "required": ["factionAccess"]
      },
      "then": {
        "required": ["factionIds"],
        "properties": {
          "factionIds": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "essentialProgression": {
            "const": true
          }
        },
        "required": ["essentialProgression"]
      },
      "then": {
        "properties": {
          "factionAccess": {
            "const": "all"
          }
        }
      }
    }
  ]
}
