{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shattered-firmament.invalid/schemas/progression-definition.schema.json",
  "title": "Progression Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "levelCap",
    "expectedHoursToCap",
    "breakthroughLevels",
    "cultivationRealms",
    "gearTiers",
    "experienceCurve",
    "statBudget"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "levelCap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "expectedHoursToCap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "breakthroughLevels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "cultivationRealms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "breakthroughLevel"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "breakthroughLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "gearTiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "levelMin",
          "levelMax",
          "expectedPowerGrowthPercent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "levelMin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "levelMax": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "expectedPowerGrowthPercent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum", "maximum"],
            "properties": {
              "minimum": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "maximum": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "experienceCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseXp", "perLevelXp", "totalXpToCap"],
      "properties": {
        "baseXp": {
          "type": "integer",
          "minimum": 1
        },
        "perLevelXp": {
          "type": "integer",
          "minimum": 0
        },
        "totalXpToCap": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "statBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offensePercent",
        "survivabilityPercent",
        "roleExpressionPercent",
        "utilityPercent",
        "maxRoleShiftPoints",
        "sameTierContributionVariancePercent"
      ],
      "properties": {
        "offensePercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "survivabilityPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "roleExpressionPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "utilityPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxRoleShiftPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "sameTierContributionVariancePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
