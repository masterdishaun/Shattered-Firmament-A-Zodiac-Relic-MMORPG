{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shattered-firmament.invalid/schemas/character-archetype.schema.json",
  "title": "Character Archetype Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "role",
    "availableFactionIds",
    "baseStats",
    "startingSkillIds"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "role": {
      "enum": [
        "vanguard",
        "striker",
        "bruiser",
        "assassin",
        "mystic",
        "support",
        "ranger",
        "disruptor"
      ]
    },
    "availableFactionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["sovereign_sect", "ashen_syndicate", "astral_concord"]
      }
    },
    "baseStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "attack", "defence", "spirit"],
      "properties": {
        "health": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "attack": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "defence": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "spirit": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "startingSkillIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" }
    },
    "startingEquipmentIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" }
    }
  }
}
